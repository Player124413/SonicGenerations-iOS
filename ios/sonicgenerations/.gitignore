# Never commit game content: players supply their own disc.
*.iso
*.xiso
*.xex

# The recompiled game code (generated/default): the original project commits
# it, so the game builds from a clone with no disc and no codegen run. Your own
# default.xex still regenerates it in place (run codegen, see README.md).
generated/*
!generated/rexglue.cmake
!generated/default/

out/

.DS_Store
